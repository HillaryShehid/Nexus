# Personal Nexus — free-first online providers
NEXUS_MODEL_MODE=free
NEXUS_PROVIDER_ORDER=gemini,groq,openrouter,mistral,cloudflare,nvidia,cohere,huggingface,ollama

# Gemini Developer API (free tier)
GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-3.8-flash

# Groq (free plan; model/rate limits are account-dependent)
GROQ_API_KEY=
NEXUS_GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter free-model router
OPENROUTER_API_KEY=
NEXUS_OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=https://github.com/HillaryShehid/Nexus

# Offline Nexus fallback
NEXUS_LOCAL_MODEL=llama3.2
NEXUS_OLLAMA_URL=http://localhost:11434/v1
NEXUS_OLLAMA_API_KEY=ollama
\n# Mistral (account access/rate limits vary)\nMISTRAL_API_KEY=\nNEXUS_MISTRAL_MODEL=mistral-small-latest\n\n# Cloudflare Workers AI\nCLOUDFLARE_API_TOKEN=\nCLOUDFLARE_ACCOUNT_ID=\nNEXUS_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast\n\n# NVIDIA NIM free endpoints\nNVIDIA_API_KEY=\nNEXUS_NVIDIA_MODEL=openai/gpt-oss-120b\n\n# Cohere trial/evaluation API\nCOHERE_API_KEY=\nNEXUS_COHERE_MODEL=command-a-plus-05-2026\n\n# Hugging Face Inference Providers\nHUGGINGFACE_API_KEY=\nNEXUS_HUGGINGFACE_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct\n