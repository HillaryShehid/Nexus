# Personal Nexus — OmniRoute is the only model gateway
NEXUS_MODEL_MODE=free
NEXUS_PROVIDER_ORDER=omniroute
NEXUS_OMNIROUTE_MODEL=auto
NEXUS_MODEL_TIMEOUT_SECONDS=25
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=sk_omniroute

# Hosted API: required for remote requests; use a random secret of 32+ characters.
# Never expose this token in browser JavaScript or commit real secrets.
# NEXUS_API_TOKEN=

# Optional comma-separated browser origins once a frontend is deployed.
# NEXUS_ALLOWED_ORIGINS=https://your-frontend.example

# Local development only: the localhost URL above works only when Nexus and
# OmniRoute run on the same machine. A cloud deployment needs a reachable,
# secured OmniRoute endpoint; do not expose an unauthenticated gateway publicly.

# Start OmniRoute separately, then connect eligible provider accounts in its dashboard.
# Its advertised ~1.62B monthly tokens are an aggregate estimate across third-party free tiers,
# not a token grant or guaranteed allowance for one user. Each provider sets its own limits.

# Voice LLM uses the same OmniRoute gateway as text chat.
NEXUS_VOICE_LLM=omniroute
NEXUS_VOICE_STT=deepgram
# Hosted voice synthesis avoids local TTS inference; provider access/usage limits apply.
NEXUS_VOICE_TTS=inference
