# Personal Nexus — free-first online providers
NEXUS_MODEL_MODE=free
NEXUS_PROVIDER_ORDER=gemini,groq,openrouter,mistral,cloudflare,nvidia,cohere,huggingface,ollama

# Gemini Developer API (free tier)
GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-3.8-flash

# Groq (free plan; model/rate limits are account-dependent)
GROQ_API_KEY=
NEXUS_GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter free-model router
OPENROUTER_API_KEY=
NEXUS_OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=https://github.com/HillaryShehid/Nexus

# Offline Nexus fallback
NEXUS_LOCAL_MODEL=llama3.2
NEXUS_OLLAMA_URL=http://localhost:11434/v1
NEXUS_OLLAMA_API_KEY=ollama

# Mistral (account access/rate limits vary)
MISTRAL_API_KEY=
NEXUS_MISTRAL_MODEL=mistral-small-latest

# Cloudflare Workers AI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEXUS_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# NVIDIA NIM free endpoints
NVIDIA_API_KEY=
NEXUS_NVIDIA_MODEL=openai/gpt-oss-120b

# Cohere trial/evaluation API
COHERE_API_KEY=
NEXUS_COHERE_MODEL=command-a-plus-05-2026

# Hugging Face Inference Providers
HUGGINGFACE_API_KEY=
NEXUS_HUGGINGFACE_MODEL=Qwen/Qwen3-Next-80B-A3B-Instruct
