# Personal Nexus — free-first online providers
NEXUS_MODEL_MODE=free
NEXUS_PROVIDER_ORDER=gemini,groq,openrouter,ollama

# Gemini Developer API (free tier)
GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-3.8-flash

# Groq (free plan; model/rate limits are account-dependent)
GROQ_API_KEY=
NEXUS_GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter free-model router
OPENROUTER_API_KEY=
NEXUS_OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=https://github.com/HillaryShehid/Nexus

# Offline Nexus fallback
NEXUS_LOCAL_MODEL=llama3.2
NEXUS_OLLAMA_URL=http://localhost:11434/v1
NEXUS_OLLAMA_API_KEY=ollama
