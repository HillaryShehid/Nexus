{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "nexus-personal-brain",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "NEXUS_MODEL",
      "NEXUS_API_TOKEN"
    ]
  },
  "containers": [
    {
      "class_name": "NexusBrainContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXUS_BRAIN",
        "class_name": "NexusBrainContainer"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "NexusBrainContainer"
      ],
      "tag": "v1"
    }
  ]
}
